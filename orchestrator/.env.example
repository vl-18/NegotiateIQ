# Copy this to .env and fill in your values. Never commit .env.

# --- Gemini: choose ONE path ---

# Path A: AI Studio key (personal local dev — get one at aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your_key_here

# Path B: Vertex AI (leave GEMINI_API_KEY unset; run `gcloud auth application-default login`)
# Or point to a service account key file — never commit that file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GCP_PROJECT_ID=negotiateiq-510510
GCP_REGION=us-central1

# --- Model overrides (optional) ---
# MERCHANT_MODEL=gemini-2.5-flash
# SHOPPING_MODEL=gemini-2.5-flash

# --- Local demo mode (skips all LLM + Firebase calls) ---
DRY_RUN=false

# --- Firestore (session + product persistence) ---
FIREBASE_PROJECT_ID=negotiateiq-510510
